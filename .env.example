# Скопируй в `.env` (gitignored) и заполни СВОИМИ значениями для dev.
# На VPS значения задаются в окружении хоста, НЕ в файлах (см. deploy/README.md).
# Никогда не коммить реальные секреты (см. Книгу 03-nonfunctional/02).
#
# PROD-КОНТРАКТ: 15 переменных ниже обязательны для deploy (docker compose prod+tls
# требует их через ${VAR:?}). Список выводится из compose-файлов скриптом
# deploy/check-env.sh — он и проверяет .env перед деплоем. Пустые значения здесь
# намеренные: шаблон не должен подставлять фальшивые секреты в прод.
POSTGRES_PASSWORD=taro_dev_only
# REDIS_PASSWORD: обязателен в prod (cache с requirepass). Генерация: openssl rand -hex 16
REDIS_PASSWORD=
# DATABASE_URL= обязателен в prod. В dev собирается из POSTGRES_PASSWORD автоматически
# (см. docker-compose.yml), в prod задаётся явно.
DATABASE_URL=
DB_HOST_PORT=5443
CACHE_HOST_PORT=6379
ADMIN_HOST_PORT=8081
ADMIN_ORIGIN=
ADMIN_API_TOKEN=
JWT_SECRET=dev-only-secret
TG_BOT_TOKEN=dev-only-bot

# Ссылка, по которой приложение открывается в Telegram. Публичный адрес бота,
# секретом не является; задаётся на сборке фронта. Пусто — приложение ещё
# не опубликовано, и приглашение привязки показывается словами.
# NEXT_PUBLIC_TG_APP_URL=https://t.me/<bot>/<app>
TG_STARS_SECRET_TOKEN=dev-only-stars
OPENROUTER_API_KEY=
AI_WORKER_MAX_ATTEMPTS=5
AI_WORKER_BACKOFF_SECONDS=30
AI_WORKER_MAX_BACKOFF_SECONDS=900
# Расписание воркера (A15/F-06). До правки обе величины были жёстко зашиты
# (batch=1, tick=30s) и давали потолок 2.00 readings/min: одно чтение за 30 с.
# TICK — период ожидания ПУСТОЙ очереди (при непустой воркер дренирует сразу),
# BATCH — сколько чтений захватывается за раз; он же ограничивает параллелизм.
AI_WORKER_TICK_SECONDS=2
AI_WORKER_BATCH_SIZE=10
# Бюджеты AI (A13/F-11): TTFT — сколько ждём первых байт ответа; генерация —
# общий дедлайн попытки (TTFT + поток). Разные значения намеренно: один общий
# таймаут обрывал healthy-генерации длиннее 8 с и открывал breaker на задержку.
# Бюджет bulk-кэша ответов AI (A16/F-05). Инстанс Redis общий для ключей
# лимитов (rl:*), сессий (sess:*/csrf:*) и кэша (ai:cache:*), поэтому кэш
# обязан быть ограничен: при allkeys-lru он вытеснял rl:*, и окно
# rate-limit обнулялось молча. Политика инстанса — noeviction.
AI_CACHE_MAX_ENTRIES=5000
# Роль ai_cache: отдельный инстанс Redis для bulk-кэша ответов AI (A17/F-43).
# В compose это сервис cache-ai (--maxmemory 128mb, volatile-ttl). На инстансе
# critical (кеши rl:*/sess:*/ent:*) вытеснение запрещено — см. A16/F-05.
# Формат REDIS_AI_ADDR: "cache-ai:6379" (отдельный инстанс) или "host:6379/1"
# (отдельная БД того же инстанса — так проверяется разделение в тестах).
REDIS_AI_ADDR=cache-ai:6379
REDIS_AI_PASSWORD=
AI_TTFT_TIMEOUT=8s
AI_GENERATION_TIMEOUT=60s
CRISIS_PATTERNS_JSON=
CRISIS_RESOURCE_TEXT=
# VAPID: сгенерируй свои! В репо их нет и быть не должно (см. S09).
# Генерация: временный go run (см. U21) или: openssl ecparam -genkey -name prime256v1
VAPID_PUBLIC_KEY=CHANGE_ME_GENERATE_YOUR_OWN
VAPID_PRIVATE_KEY=CHANGE_ME_GENERATE_YOUR_OWN
# REDIS_ENC_KEY: AES-256 для ai:cache. В prod обязателен (AI_REQUIRE_CACHE_ENCRYPTION=1),
# без него Redis plaintext — см. E13 + AUDIT-EXCEPTION(E13). Генерация: openssl rand -hex 32
REDIS_ENC_KEY=
# TLS_CERT_DIR: обязателен, если TLS завершает сам nginx (deploy/docker-compose.tls.yml),
# каталог с fullchain.pem/privkey.pem. При TLS на хосте/certbot — не задаётся.
TLS_CERT_DIR=
# Публичные build-time vars фронта (не секреты; пекутся в бандл при docker compose build):
PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# Стенд сцены (/design-lab): слайдеры света/тумана/камней. Только для разработки.
# В проде без этого флага роут отдаёт заглушку «Стенд закрыт».
# По умолчанию 0. Включать только локально: NEXT_PUBLIC_DESIGN_LAB=1
# Флаг попадает в образ на СБОРКЕ, поэтому после правки нужен rebuild web.
NEXT_PUBLIC_DESIGN_LAB=0
