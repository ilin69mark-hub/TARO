# api-public — см. docs/project-book/04-architecture/01 (порт 8080 наружу через nginx)
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /api-public ./cmd/api

FROM alpine:3.20
# S09: tzdata (MSK-время!), non-root, healthcheck
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -u 10001 app
COPY --from=build /api-public /api-public
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/api-public"]
