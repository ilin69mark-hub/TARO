# api-public — см. docs/project-book/04-architecture/01 (порт 8080 наружу через nginx)
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /api-public ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /api-public /api-public
EXPOSE 8080
ENTRYPOINT ["/api-public"]
